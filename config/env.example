# fake-printer — generated by scripts/setup.ps1 into <install root>\.env
# NOTE: values containing spaces MUST be quoted: KEY="a b"

IPP_LISTEN_HOST=0.0.0.0
IPP_LISTEN_PORT=8631
IPP_PATH=/ipp/print
IPP_MAX_BYTES=104857600
IPP_SPOOL_DIR=REPLACE_SPOOL_DIR
IPP_RENDER_DPI=200
IPP_TEMP_DIR=REPLACE_TEMP_DIR

# mDNS instance name shown to clients (quote — it contains a space)
PRINTER_NAME="Fake Printer"

LOG_LEVEL=INFO
LOG_HEADERS=false

POST_ENDPOINT=
PAPER_ID=
POST_AUTH_HEADER=x-api-key
POST_AUTH_VALUE=
POST_TIMEOUT_SECONDS=30
POST_FILE_FIELD=file
POST_INCLUDE_META_FIELDS=true
POST_SEND_ALL_PAGES=false

IPP_SHARED_TOKEN=
