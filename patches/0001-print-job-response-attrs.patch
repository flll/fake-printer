+
+    def job_activity_end(self, grace_seconds: int) -> None:
+        # Keep reporting "processing" for a short grace window after the job so
+        # ~1s status pollers reliably observe the processing -> idle transition.
+        with self._job_lock:
+            self._busy_depth = max(0, self._busy_depth - 1)
+            self._busy_grace_until = max(
+                self._busy_grace_until, time.monotonic() + max(0, grace_seconds)
+            )
+
+    def printer_is_busy(self) -> bool:
+        with self._job_lock:
+            return self._busy_depth > 0 or time.monotonic() < self._busy_grace_until
 
